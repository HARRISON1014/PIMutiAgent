{
  "name": "piagent-mission-control",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local multi-provider collaboration with configurable roles, API and account CLI connections, and manual task assignment",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js",
    "launch": "node scripts/launch.js",
    "check:publish": "node scripts/check-publish.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "typebox": "1.3.27",
    "zod": "4.3.6"
  }
}
